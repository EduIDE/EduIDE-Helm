{
  "uid": "__UID__",
  "title": "EduIDE Pool-Scaler (__NAMESPACE__)",
  "tags": [
    "eduide",
    "pool-scaler"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Overrides",
        "expr": "pool_scaler_override_active{namespace=\"__NAMESPACE__\"} == 1",
        "step": "5m",
        "titleFormat": "Override",
        "textFormat": "{{appdef}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Strategy changes",
        "expr": "changes(pool_scaler_active_strategy{namespace=\"__NAMESPACE__\"}[5m]) > 0 and pool_scaler_active_strategy{namespace=\"__NAMESPACE__\"} == 1",
        "step": "5m",
        "titleFormat": "Active strategy",
        "textFormat": "{{strategy}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "appdef",
        "label": "AppDefinition",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(pool_scaler_target_idle{namespace=\"__NAMESPACE__\"}, appdef)",
        "query": {
          "query": "label_values(pool_scaler_target_idle{namespace=\"__NAMESPACE__\"}, appdef)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Pool per AppDefinition",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "targetIdle: wish per strategy and decided value",
      "description": "Dashed: what each strategy would set (active=\"true\" is the active one). Solid: what the scaler decided after guardrails, override and budget.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (appdef, strategy, active) (pool_scaler_desired_idle{namespace=\"__NAMESPACE__\", appdef=~\"$appdef\"})",
          "legendFormat": "{{appdef}} {{strategy}} (active={{active}})",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (appdef) (pool_scaler_target_idle{namespace=\"__NAMESPACE__\", appdef=~\"$appdef\"})",
          "legendFormat": "{{appdef}} decided",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pool pods by state",
      "description": "Free (ready, starting) and claimed pool pods, from the operator. Gauges come from the leader only.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
