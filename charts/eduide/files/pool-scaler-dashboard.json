          "editorMode": "code",
          "expr": "sum by (app_definition) (rate(eduide_session_claims_total{namespace=\"__NAMESPACE__\", app_definition=~\"$appdef\", result=\"warm_ready\"}[1h])) / sum by (app_definition) (rate(eduide_session_claims_total{namespace=\"__NAMESPACE__\", app_definition=~\"$appdef\"}[1h]))",
          "legendFormat": "{{app_definition}}",
          "range": true,
          "refId": "A"
