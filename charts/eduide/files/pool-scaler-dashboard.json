        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (app_definition, state) (eduide_pool_instances{namespace=\"__NAMESPACE__\", app_definition=~\"$appdef\"})",
          "legendFormat": "{{app_definition}} {{state}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Claims per minute by result",
      "description": "warm_ready: a ready pod. warm_starting: a pod still starting. cold: no free pod, the session started from scratch. Rejected: sessions refused for lack of capacity or at maxInstances.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(eduide_session_claims_total{namespace=\"__NAMESPACE__\", app_definition=~\"$appdef\"}[5m])) * 60",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(eduide_session_rejected_total{namespace=\"__NAMESPACE__\", app_definition=~\"$appdef\"}[5m])) * 60",
          "legendFormat": "rejected {{reason}}",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Warm-ready ratio",
      "description": "Share of claims served by a ready pool pod over the last hour.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
